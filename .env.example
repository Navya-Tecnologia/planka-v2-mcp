# ==========================================
# Planka MCP Server Configuration (.env)
# ==========================================

# --- Planka URL Configuration ---
PLANKA_BASE_URL=https://task.example.com

# --- Agent (LLM) Credentials ---
PLANKA_AGENT_EMAIL=agent@example.com
PLANKA_AGENT_PASSWORD=your_password_here

# --- Optional: Admin ID for specific operations ---
PLANKA_ADMIN_ID=1732845851673363594

# --- Docker & Portainer Deployment ---
MCP_PORT=3000
MCP_NETWORK=net_mcp
CONTAINER_NAME=planka-mcp

# --- Connection Settings ---
# SECURITY NOTE: Only set PLANKA_IGNORE_SSL=true if using self-signed certs on internal networks.
PLANKA_IGNORE_SSL=false

# --- Custom / Private Skill Markdown ---
# Path inside container for skill file (defaults to /app/docs/private/satya-planka-skill.md)
# MCP_SKILL_FILE_PATH=/app/docs/private/satya-planka-skill.md
# Host path mapped to /app/docs/private
# PRIVATE_SKILLS_PATH=/docker/planka-mcp/docs/private

# --- Security Hardening (SSRF Protection & Gateway Auth) ---
# MCP_API_KEY=your-strong-random-api-key
# PLANKA_ALLOWED_HOSTS=task.example.com,planka.internal,localhost
# ALLOW_ANONYMOUS_ENV_FALLBACK: set to 'true' to allow connecting without per-request credentials
ALLOW_ANONYMOUS_ENV_FALLBACK=true
