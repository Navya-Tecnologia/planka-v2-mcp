# Planka URL Configuration
PLANKA_BASE_URL=https://task.example.com

# Agent (LLM) Credentials 
PLANKA_AGENT_EMAIL=agent@example.com
PLANKA_AGENT_PASSWORD=your_password_here

# Optional: Admin ID for specific operations
PLANKA_ADMIN_ID=1732845851673363594

# Connection settings
# SECURITY NOTE: Only set PLANKA_IGNORE_SSL=true if using self-signed certs on internal networks.
PLANKA_IGNORE_SSL=false
PLANKA_PORT=1337

# Optional: Path to custom/private skill markdown file for embedded MCP instructions & resources
# MCP_SKILL_FILE_PATH=./docs/private/custom-skill.md

# Security Hardening (SSRF Protection & Gateway Auth)
# MCP_API_KEY=your-strong-random-api-key
# PLANKA_ALLOWED_HOSTS=task.example.com,planka.internal,localhost
# ALLOW_ANONYMOUS_ENV_FALLBACK=false
